---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV_CATEGORIES, SITE } from '../consts';
import { categoryPath } from '../utils';
---

<BaseLayout
  title="About"
  description="Learn about HairMuse, a hairstyle journal with practical guides for braids, updos, waves, bangs and everyday styling."
>
  <section class="wrap">
    <div class="page-head">
      <span class="kicker">About HairMuse</span>
      <h1>Good hair ideas, <em style="color:var(--accent)">clear steps</em></h1>
      <p class="lede">
        HairMuse is a place to explore hairstyles and learn the techniques behind them.
      </p>
    </div>

    <div class="prose">
      <p>
        We publish guides for specific looks, from a simple braid to a polished
        updo. Each guide explains the tools, the order of the steps and the
        adjustments that may help with different hair lengths or textures.
      </p>

      <h2>What you&rsquo;ll find</h2>
      <ul>
        {
          NAV_CATEGORIES.map((c) => (
            <li>
              <a href={categoryPath(c)}>{c}</a> — guides and styling ideas
              focused on this category.
            </li>
          ))
        }
      </ul>

      <h2>About the images</h2>
      <p>
        Cover images are original AI-generated illustrations created for
        HairMuse. They show the hairstyle discussed in an article, but they are
        not photographs of the tutorial steps. Your result will depend on your
        hair, tools and technique.
      </p>

      <h2>Get in touch</h2>
      <p>
        Find us on <a href={SITE.pinterest} target="_blank" rel="noopener noreferrer">Pinterest</a>
        at {SITE.pinterestHandle}, or email
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a> with questions and feedback.
      </p>
    </div>

    <div class="cta-band">
      <h2>Explore the guides</h2>
      <p>Start with a look you like, then follow the steps at your own pace.</p>
      <a class="btn" href="/hairstyles/">Browse all posts</a>
    </div>
  </section>
</BaseLayout>
