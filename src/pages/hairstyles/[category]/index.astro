---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { SITE } from '../../../consts';
import { slugify, sortPosts } from '../../../utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const categories = [...new Set(posts.map((p) => p.data.category))];

  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: { category },
  }));
}


const CATEGORY_GUIDES: Record<string, { heading: string; body: string }[]> = {
  'Bangs & Bobs': [
    {
      heading: 'Pixie cuts, matched to your hair',
      body: 'Start with your texture. Curly hair needs a dry cut and room for shrinkage, which is where <a href="/hairstyles/bangs-bobs/curly-pixie-cuts/">curly pixie cuts</a> begins; softer, feathered shapes live in <a href="/hairstyles/bangs-bobs/feminine-pixie-cuts/">feminine pixie cuts</a>. A fringe changes the whole read of a pixie, so <a href="/hairstyles/bangs-bobs/pixie-cuts-with-bangs/">pixie cuts with bangs</a> compares the fringe styles honestly, and if you want the drama without the full chop, <a href="/hairstyles/bangs-bobs/long-pixie-cuts/">long pixie cuts</a> keep length through the top.',
    },
    {
      heading: 'Short cuts for your face, age and upkeep',
      body: 'Face shape decides where the volume goes: <a href="/hairstyles/bangs-bobs/pixie-cuts-for-round-faces/">pixie cuts for round faces</a> put height on top and keep the sides close. Later in life, <a href="/hairstyles/bangs-bobs/pixie-cuts-for-women-over-60/">pixie cuts for women over 60</a> covers silver hair, finer texture and glasses-friendly fringes. The boldest option here is the <a href="/hairstyles/bangs-bobs/undercut-pixie-cuts/">undercut pixie</a>, and the full short-hair overview — pixies, crops and bobs side by side — is our guide to <a href="/hairstyles/bangs-bobs/short-haircuts-for-women/">short haircuts for women</a>.',
    },
    {
      heading: 'Bobs and fringes',
      body: 'The bob family starts with the <a href="/hairstyles/bangs-bobs/bob-haircuts/">bob haircuts</a> pillar: lengths, shapes and who each one suits. The <a href="/hairstyles/bangs-bobs/french-bob-comeback/">French bob</a> is the chic, jaw-length revival, and the <a href="/hairstyles/bangs-bobs/pixie-bob-haircuts/">pixie bob</a> sits between the two cuts. For fringes, the <a href="/hairstyles/bangs-bobs/curtain-bangs-guide/">curtain bangs guide</a> covers cutting and styling, and <a href="/hairstyles/bangs-bobs/growing-out-bangs/">growing out bangs</a> gets you through the awkward months in between.',
    },
  ],
  'Occasion Hairstyles': [
    {
      heading: 'Dances, photos and the styles that survive both',
      body: 'For the big school nights, <a href="/hairstyles/occasion-hairstyles/homecoming-hairstyles/">homecoming hairstyles</a> and <a href="/hairstyles/occasion-hairstyles/prom-hairstyles/">prom hairstyles</a> are built around the same honest test: the style has to hold through hours of dancing and still look right in the last photo of the night. Each guide covers hold, touch-ups and which looks suit which neckline, so the choice starts from the dress rather than the trend.',
    },
    {
      heading: 'Wedding-guest and party hair',
      body: 'Guests get one rule the bridal party does not: polished, never competing. <a href="/hairstyles/occasion-hairstyles/wedding-guest-half-up-waves/">wedding guest half-up waves</a> is the reliable middle ground — dressed up, off the face, and achievable at home in under an hour. For the festive season, <a href="/hairstyles/occasion-hairstyles/christmas-hairstyles/">Christmas hairstyles</a> collects party looks from sleek to sparkly, and <a href="/hairstyles/occasion-hairstyles/hair-tinsel/">hair tinsel</a> adds the shimmer without dye, heat or commitment.',
    },
    {
      heading: 'Plan the style around the day',
      body: 'Occasion hair fails on logistics more than technique: styles chosen the night before, untested products, no plan for wind or a long car ride. Every guide in this section includes a trial-run note and a small kit list — the pins, spray and backup accessory that rescue a style in five minutes. Work backwards from the event time, practise once, and the day itself gets much calmer.',
    },
  ],
  'Hair Color': [
    {
      heading: 'Brunettes: depth without the upkeep spiral',
      body: 'The brunette guides start from maintenance honesty. <a href="/hairstyles/hair-color/brunette-balayage/">Brunette balayage</a> grows out softly enough to stretch salon visits, <a href="/hairstyles/hair-color/light-brown-hair-color-ideas/">light brown hair colour ideas</a> covers the shades that lift a base without bleach drama, and <a href="/hairstyles/hair-color/cherry-cola-brunette-hair/">cherry cola brunette</a> is the rich red-brown for anyone who wants warmth that reads expensive rather than bright.',
    },
    {
      heading: 'Coppers and warm reds',
      body: 'Copper is the family that fades fastest, and the guides say so up front. <a href="/hairstyles/hair-color/copper-hair-color/">Copper hair colour</a> compares the shades from penny-bright to deep rust with the upkeep each one really needs, and <a href="/hairstyles/hair-color/cowboy-copper-hair/">cowboy copper</a> is its deeper, brunette-based cousin — the lower-maintenance way into the trend, with gloss and wash routines that keep the tone alive between appointments.',
    },
    {
      heading: 'Blonding, brightness and the money piece',
      body: 'For lighter directions, <a href="/hairstyles/hair-color/honey-blonde-hair-color/">honey blonde</a> is the warm, forgiving blonde that suits more skin tones than the ash shades do. The fastest visible change is smaller: the <a href="/hairstyles/hair-color/money-piece-hair/">money piece</a> — face-framing brightness at the front only — refreshes a whole colour in a fraction of the chair time and grows out without a harsh line.',
    },
  ],
  'Haircuts': [
    {
      heading: 'Layers, matched to your length',
      body: 'The layered family is organised by length here. The overview is <a href="/hairstyles/haircuts/layered-haircuts/">layered haircuts</a> — what layers do and who they suit — then by length: <a href="/hairstyles/haircuts/long-layered-haircuts/">long layered haircuts</a> keep the length and lose the weight, <a href="/hairstyles/haircuts/medium-length-layered-haircuts/">medium-length layered haircuts</a> are the most versatile of the set, and the <a href="/hairstyles/haircuts/lob-haircut/">lob</a> sits at the polished end of medium. Add a fringe and it becomes <a href="/hairstyles/haircuts/layered-haircuts-with-bangs/">layered haircuts with bangs</a>.',
    },
    {
      heading: 'Shape first: face, fringe and the front layers',
      body: 'Where the shortest layer lands decides how a cut reads. <a href="/hairstyles/haircuts/face-framing-layers/">Face-framing layers</a> do the shaping work at the front without touching the back, and <a href="/hairstyles/haircuts/layered-haircuts-for-round-faces/">layered haircuts for round faces</a> place the volume where it lengthens rather than widens. The <a href="/hairstyles/haircuts/butterfly-haircut/">butterfly haircut</a> is the dramatic version — two layer lengths in one cut — and its <a href="/hairstyles/haircuts/curly-butterfly-cut/">curly butterfly cut</a> sibling adapts the same idea for natural curl shrinkage.',
    },
    {
      heading: 'The textured family: shag, wolf, hush and octopus',
      body: 'Four cousins, four different finishes. The <a href="/hairstyles/haircuts/shag-haircut-for-women/">shag</a> is the choppy original, the <a href="/hairstyles/haircuts/wolf-cut-for-women/">wolf cut</a> its wilder mullet-leaning descendant, the <a href="/hairstyles/haircuts/hush-cut/">hush cut</a> the soft, quiet Korean take, and the <a href="/hairstyles/haircuts/octopus-haircut/">octopus cut</a> keeps a smooth top over wispy, separated ends. Each guide carries a comparison section against the others, so the differences are settled before the salon visit, not during it.',
    },
  ],
  'Braids': [
    {
      heading: 'Start here: the three-strand foundations',
      body: 'Every braid on this page descends from three techniques. <a href="/hairstyles/braids/how-to-french-braid/">How to French braid</a> is the core skill — gathering as you go — and <a href="/hairstyles/braids/how-to-dutch-braid/">how to Dutch braid</a> is its mirror image, crossing under so the braid stands proud of the head. The <a href="/hairstyles/braids/beginner-braid-guide/">beginner braid guide</a> sequences the practice honestly, and <a href="/hairstyles/braids/types-of-braids/">types of braids</a> is the full map of where each foundation leads.',
    },
    {
      heading: 'Next level: fishtail, waterfall and rope',
      body: 'Once the foundations hold, three braids change the texture rather than the structure. The <a href="/hairstyles/braids/how-to-fishtail-braid/">fishtail braid</a> uses two sections and patience for its woven finish, the <a href="/hairstyles/braids/how-to-waterfall-braid/">waterfall braid</a> drops strands as it travels for a half-up cascade, and <a href="/hairstyles/braids/rope-braid-ponytail/">rope braid ponytail</a> twists two strands into the fastest braid-adjacent style here. <a href="/hairstyles/braids/bubble-braids/">Bubble braids</a> cheat entirely — elastics, no weaving at all.',
    },
    {
      heading: 'Worn up: crowns, milkmaids and ponytails',
      body: 'Braids that become the updo itself start with the <a href="/hairstyles/braids/crown-braid-hairstyles/">crown braid</a> — one braid circling the head — and its close cousin the <a href="/hairstyles/braids/milkmaid-braid/">milkmaid braid</a>, built from two plaits pinned over the top; each guide states plainly where it overlaps the other. <a href="/hairstyles/braids/braided-ponytail-hairstyles/">Braided ponytail hairstyles</a> collect the worn-down and worn-up hybrids, <a href="/hairstyles/braids/double-dutch-braids/">double Dutch braids</a> are the sport-proof pair, and <a href="/hairstyles/braids/boho-braids/">boho braids</a> loosen everything for the festival end of the scale.',
    },
  ],
  'Waves & Curls': [
    {
      heading: 'Heatless curls: the overnight family',
      body: 'The heatless methods are compared honestly here, because they do not all do the same job. <a href="/hairstyles/waves-curls/sock-curls/">Sock curls</a> give the tightest, longest-lasting result, <a href="/hairstyles/waves-curls/robe-belt-curls/">robe belt curls</a> are the softer, quicker wrap, and the full comparison lives in <a href="/hairstyles/waves-curls/heatless-curls-overnight/">heatless curls overnight</a>. Length changes the method: <a href="/hairstyles/waves-curls/heatless-curls-for-short-hair/">heatless curls for short hair</a> adapts the wrap for bobs, and <a href="/hairstyles/waves-curls/heatless-curls-for-long-hair/">heatless curls for long hair</a> deals with weight and drying time.',
    },
    {
      heading: 'Volume with heat: rollers and the blowout',
      body: 'For the lifted, bouncy end of the category, <a href="/hairstyles/waves-curls/velcro-rollers/">velcro rollers</a> are the deep-dive — sizes, placement and the cool-down rule that makes the set hold. The <a href="/hairstyles/waves-curls/90s-blowout-hair/">90s blowout</a> tutorial then uses them one of three ways, alongside the round-brush technique, for the full supermodel finish. Both guides are honest about lifespan: this is a same-day style, and humidity is its enemy.',
    },
    {
      heading: 'Natural texture and old-Hollywood polish',
      body: 'Two opposite directions close the category. <a href="/hairstyles/waves-curls/diffuser-natural-waves/">Diffuser natural waves</a> works with the texture you already have — product order, diffuser technique and the no-touch drying rule. <a href="/hairstyles/waves-curls/hollywood-glamour-waves/">Hollywood glamour waves</a> are the constructed opposite: a uniform, brushed-out S-wave that takes setting, patience and a proper brush-through to read as vintage rather than pageant.',
    },
  ],
  'Updos & Buns': [
    {
      heading: 'Buns, matched to the day',
      body: 'The bun family splits by finish. <a href="/hairstyles/updos-buns/messy-buns-that-hold/">Messy buns that hold</a> is the everyday problem solved — texture, grip and the pinning order that stops the slump by midday. <a href="/hairstyles/updos-buns/low-bun-hairstyles/">Low bun hairstyles</a> sit at the nape and read calm and polished, while the <a href="/hairstyles/updos-buns/slick-back-bun/">slick back bun</a> is the sleek extreme: gelled, tight and deliberately severe. <a href="/hairstyles/updos-buns/space-buns/">Space buns</a> are the playful end — two buns, worn high, with honest notes on who they flatter.',
    },
    {
      heading: 'The pinned classics: chignon and French twist',
      body: 'Two French classics anchor the formal end. The <a href="/hairstyles/updos-buns/chignon-hairstyle/">chignon</a> coils flat at the nape; the <a href="/hairstyles/updos-buns/french-twist-hairstyle/">French twist</a> rolls vertically up the back of the head — each guide states plainly where it overlaps the other and which neckline each one wants. For pins without the architecture, <a href="/hairstyles/updos-buns/soft-bobby-pin-updos/">soft bobby pin updos</a> gather hair loosely and forgive imperfect technique, which makes them the kindest first updo here.',
    },
    {
      heading: 'Claw clips and half-up: the in-between updos',
      body: 'Not every updo is all-or-nothing. <a href="/hairstyles/updos-buns/claw-clip-hairstyles/">Claw clip hairstyles</a> are the five-minute default, and the <a href="/hairstyles/updos-buns/claw-clip-french-twist/">claw clip French twist</a> borrows the classic twist shape with a clip doing the pinning — the guide is honest about where the shortcut shows. <a href="/hairstyles/updos-buns/half-up-half-down-hairstyles/">Half-up half-down hairstyles</a> keep the length visible while clearing the face, and <a href="/hairstyles/updos-buns/braided-ponytail-hairstyles/">braided ponytail hairstyles</a> file the ponytail hybrids here because the braid is doing the updo work.',
    },
  ],
};

const { category } = Astro.props;
const posts = sortPosts(
  (await getCollection('blog', ({ data }) => !data.draft)).filter(
    (p) => p.data.category === category
  )
);

const guide = CATEGORY_GUIDES[category];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${category} Hairstyle Posts`,
    url: new URL(Astro.url.pathname, Astro.site).toString(),
    description: `All ${category} tutorials and hairstyle ideas from ${SITE.name}.`,
    isPartOf: { '@type': 'Blog', name: `${SITE.name} Blog` },
  },
];
---

<BaseLayout
  title={`${category} Hairstyles`}
  description={`Browse ${category.toLowerCase()} guides and hairstyle ideas from HairMuse, with practical steps and styling tips.`}
  schema={schema}
>
  <section class="wrap">
    <div class="page-head">
      <span class="kicker">Category</span>
      <h1>{category}</h1>
      <p class="lede">
        All of our {category.toLowerCase()} tutorials and ideas — save the ones
        you want to try this week.
      </p>
    </div>

    <p class="count-note">
      {posts.length}
      {posts.length === 1 ? 'post' : 'posts'} in this category
    </p>

    {
      guide && (
        <div class="category-guide">
          {guide.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              <p set:html={section.body} />
            </section>
          ))}
        </div>
      )
    }

    <div class="board">
      {posts.map((post, i) => <PostCard post={post} eager={i < 3} />)}
    </div>
  </section>
</BaseLayout>
