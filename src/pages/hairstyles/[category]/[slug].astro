---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { SITE } from '../../../consts';
import { categoryPath, formatDate, postPath, readTime, slugify, sortPosts } from '../../../utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { category: slugify(post.data.category), slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, seoTitle, description, pubDate, updatedDate, category, image, imageAlt, tags, pinDescription } =
  post.data;

const allPosts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
const index = allPosts.findIndex((p) => p.id === post.id);
const newer = index > 0 ? allPosts[index - 1] : undefined;
const older = index < allPosts.length - 1 ? allPosts[index + 1] : undefined;

const related = allPosts
  .filter((p) => p.id !== post.id && p.data.category === category)
  .concat(allPosts.filter((p) => p.id !== post.id && p.data.category !== category))
  .slice(0, 3);

const minutes = readTime(post.body);
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const categoryURL = `${SITE.url}${categoryPath(category)}`;

const pinUrl = `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(
  canonical.toString()
)}&media=${encodeURIComponent(imageURL.toString())}&description=${encodeURIComponent(
  pinDescription ?? description
)}`;
const xUrl = `https://twitter.com/intent/tweet?url=${encodeURIComponent(
  canonical.toString()
)}&text=${encodeURIComponent(title)}`;
const fbUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical.toString())}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${canonical}#article`,
    headline: seoTitle ?? title,
    description,
    image: imageURL.toString(),
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: { '@type': 'Organization', name: SITE.author, url: SITE.url },
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).toString() },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.toString() },
    keywords: [category, ...tags].join(', '),
    wordCount: (post.body ?? '').trim().split(/\s+/).length,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: category, item: categoryURL },
      { '@type': 'ListItem', position: 3, name: title },
    ],
  },
];
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  image={image}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  schema={schema}
>
  <article class="wrap">
    <header class="post-header">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep" aria-hidden="true">&rsaquo;</span>
        <a href={categoryURL}>{category}</a>
        <span class="sep" aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">{title}</span>
      </nav>

      <h1>{title}</h1>

      <p class="post-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span class="dot" aria-hidden="true">&bull;</span>
        <span>{minutes} min read</span>
        <span class="dot" aria-hidden="true">&bull;</span>
        <a href={categoryURL}>{category}</a>
      </p>
    </header>

    <figure class="post-hero">
      <img
        src={image}
        alt={imageAlt}
        width="800"
        height="1200"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption>Illustrative hairstyle image: {imageAlt}</figcaption>
    </figure>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-footer">
      <div class="tag-row">
        {tags.map((tag) => <span class="tag">#{tag.replace(/\s+/g, '')}</span>)}
      </div>

      <div class="share-row">
        <span class="share-label">Share &amp; save</span>
        <a class="share-btn" href={pinUrl} target="_blank" rel="noopener noreferrer">Pin it</a>
        <a class="share-btn" href={xUrl} target="_blank" rel="noopener noreferrer">Post on X</a>
        <a class="share-btn" href={fbUrl} target="_blank" rel="noopener noreferrer">Facebook</a>
      </div>
    </footer>

    <nav class="post-nav" aria-label="More posts">
      {
        older ? (
          <a href={postPath(older)} class="prev">
            <span class="dir">&larr; Older post</span>
            {older.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a href={postPath(newer)} class="next">
            <span class="dir">Newer post &rarr;</span>
            {newer.data.title}
          </a>
        )
      }
    </nav>

    <section class="section" aria-labelledby="related-heading">
      <div class="section-head">
        <div>
          <span class="kicker">Keep scrolling</span>
          <h2 id="related-heading" style="font-size: clamp(1.5rem, 3vw, 2rem)">You may also love</h2>
        </div>
        <a class="view-all" href="/hairstyles/">All posts</a>
      </div>
      <div class="grid-3">
        {related.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  </article>

  <script is:inline>
    (() => {
      function initPinterestSave() {
        const pageUrl = window.location.href;
        const pageTitle = document.title;
        const images = document.querySelectorAll('.post-hero img, .article-image img, .prose img');

        images.forEach((img) => {
          if (img.dataset.pinReady) return;
          img.dataset.pinReady = 'true';

          const src = img.getAttribute('src');
          if (!src) return;
          const fullMedia = src.startsWith('http') ? src : new URL(src, window.location.origin).href;
          const altText = img.getAttribute('alt') || pageTitle;

          img.setAttribute('data-pin-media', fullMedia);
          img.setAttribute('data-pin-url', pageUrl);
          img.setAttribute('data-pin-description', altText);
          img.setAttribute('data-pin-hover', 'true');
          img.setAttribute('data-pin-do', 'buttonPin');

          const parent = img.parentElement;
          let container = parent;
          if (parent && (parent.tagName === 'FIGURE' || parent.classList.contains('article-image') || parent.classList.contains('post-hero'))) {
            container = parent;
            container.classList.add('pin-media-wrap');
          } else if (parent && !parent.classList.contains('pin-media-wrap')) {
            const wrap = document.createElement('div');
            wrap.className = 'pin-media-wrap';
            parent.insertBefore(wrap, img);
            wrap.appendChild(img);
            container = wrap;
          }

          if (container && !container.querySelector('.pin-save-btn')) {
            const pinLink = `https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(pageUrl)}&media=${encodeURIComponent(fullMedia)}&description=${encodeURIComponent(altText)}`;
            const btn = document.createElement('a');
            btn.className = 'pin-save-btn';
            btn.href = pinLink;
            btn.target = '_blank';
            btn.rel = 'noopener noreferrer';
            btn.setAttribute('aria-label', `Save to Pinterest: ${altText}`);
            btn.innerHTML = `
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.291 1.199-.332 1.365-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.751 2.864c-.272 1.045-1.009 2.352-1.498 3.146 1.123.345 2.306.535 3.541.535 6.627 0 12-5.373 12-12C24 5.373 18.627 0 12 0z"/>
              </svg>
              <span>Save</span>
            `;
            btn.addEventListener('click', (e) => {
              e.preventDefault();
              window.open(pinLink, 'pin_' + Math.random().toString(36).substring(7), 'width=750,height=600,scrollbars=yes,resizable=yes');
            });
            container.appendChild(btn);
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPinterestSave);
      } else {
        initPinterestSave();
      }
    })();
  </script>
  <script async defer src="https://assets.pinterest.com/js/pinit.js"></script>
</BaseLayout>
