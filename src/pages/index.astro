---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../consts';
import { formatDate, readTime, slugify, sortPosts } from '../utils';

const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
const [featured, ...board] = posts;
if (!featured) {
  throw new Error('Homepage needs at least one published (non-draft) post in src/content/blog/.');
}
// slice() never yields undefined entries, even with fewer than 4 posts
const collage = posts.slice(1, 4);

const categories = [...new Set(posts.map((p) => p.data.category))].map((category) => ({
  category,
  count: posts.filter((p) => p.data.category === category).length,
}));

const featuredMinutes = readTime(featured.body);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
];
---

<BaseLayout title={SITE.title} description={SITE.description} schema={schema}>
  <!-- Hero -->
  <section class="wrap hero">
    <div>
      <span class="kicker">A hairstyle journal</span>
      <h1>Hairstyle ideas you&rsquo;ll <em>actually</em> want to try</h1>
      <p class="hero-lede">
        Step-by-step hair tutorials, saved-worthy inspiration and honest tips —
        written for the Pinterest girlies who screenshot every bun, braid and bob.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/blog/">Browse the board</a>
        <a class="btn btn-ghost" href={SITE.pinterest} target="_blank" rel="noopener noreferrer">
          Follow on Pinterest
        </a>
      </div>
    </div>
    <div class="pin-stack" aria-hidden="true">
      {collage.map((post) => <img src={post.data.image} alt="" width="800" height="1200" loading="eager" fetchpriority="high" />)}
    </div>
  </section>

  <!-- Featured post -->
  <section class="wrap section" aria-labelledby="featured-heading">
    <div class="section-head">
      <div>
        <span class="kicker">Don&rsquo;t miss it</span>
        <h2 id="featured-heading">Latest on the blog</h2>
      </div>
      <a class="view-all" href="/blog/">View all posts</a>
    </div>

    <article class="featured">
      <a class="featured-media" href={`/blog/${featured.id}/`} tabindex="-1" aria-hidden="true">
        <img
          src={featured.data.image}
          alt={featured.data.imageAlt}
          width="800"
          height="1200"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </a>
      <div class="featured-body">
        <span class="card-eyebrow" style="margin-top:0">{featured.data.category}</span>
        <h2><a href={`/blog/${featured.id}/`}>{featured.data.title}</a></h2>
        <p class="featured-excerpt">{featured.data.description}</p>
        <p class="card-meta" style="margin-bottom:1.6rem">
          {formatDate(featured.data.pubDate)} &middot; {featuredMinutes} min read
        </p>
        <p><a class="btn" href={`/blog/${featured.id}/`}>Read the tutorial</a></p>
      </div>
    </article>
  </section>

  <!-- Masonry board -->
  <section class="wrap section" aria-labelledby="board-heading">
    <div class="section-head">
      <div>
        <span class="kicker">The board</span>
        <h2 id="board-heading">Fresh from the board</h2>
      </div>
    </div>

    <div class="pill-row">
      {
        categories.map(({ category, count }) => (
          <a class="pill" href={`/category/${slugify(category)}/`}>
            {category} ({count})
          </a>
        ))
      }
    </div>

    <div class="board">
      {board.map((post, i) => <PostCard post={post} eager={i < 2} />)}
    </div>
  </section>

  <!-- CTA -->
  <section class="wrap">
    <div class="cta-band">
      <h2>Save it before it scrolls away</h2>
      <p>
        Every tutorial lives on the blog, but the daily dose of hairspiration is on
        Pinterest. Follow {SITE.name} there so you never lose a look you love.
      </p>
      <a class="btn" href={SITE.pinterest} target="_blank" rel="noopener noreferrer">
        Follow {SITE.pinterestHandle} on Pinterest
      </a>
    </div>
  </section>
</BaseLayout>
