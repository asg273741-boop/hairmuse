---
import { NAV_CATEGORIES } from '../consts';
import { categoryPath } from '../utils';

const path = Astro.url.pathname;

const activeCat = NAV_CATEGORIES.find((c) => path.startsWith(categoryPath(c)));
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">Hair<em>Muse</em></a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-burger" aria-label="Toggle navigation menu">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <nav class="site-nav" aria-label="Main navigation">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
      <a href="/hairstyles/" aria-current={path === '/hairstyles/' ? 'page' : undefined}>All Posts</a>
      {
        NAV_CATEGORIES.map((c) => (
          <a href={categoryPath(c)} aria-current={activeCat === c ? 'page' : undefined}>
            {c}
          </a>
        ))
      }
      <a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About</a>
      <a href="/contact/" aria-current={path === '/contact/' ? 'page' : undefined}>Contact</a>
    </nav>
  </div>
</header>
